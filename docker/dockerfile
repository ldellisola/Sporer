# The web app is built first and on its own: Node is only in this stage, and the .NET stages below never see it. The package files
# come before the sources, so that the dependencies are installed again only when they change. `npm run build` type-checks the app
# (tsc) and then builds it; the output goes to /web-dist instead of the web root of the API's source tree, where vite.config.ts
# puts it for local work.
FROM node:22-alpine AS build-web
WORKDIR /web
COPY ./web/package.json ./web/package-lock.json ./
RUN npm ci
COPY ./web ./
RUN npm run build -- --outDir /web-dist

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-backend
# Set by buildx to the architecture being built (amd64, arm64); empty with the classic builder.
ARG TARGETARCH
WORKDIR /src

# The API is published ReadyToRun: its code and its packages' are compiled ahead of time, so that the first requests, the first edit and the first
# refresh after a start do not wait for the JIT. That code is for one architecture, so restore and publish both name its runtime identifier,
# taken from the architecture being built. It stays framework-dependent (the runtime is the aspnet image's, as before); the runtime pack and
# the compiler that ReadyToRun needs are fetched here, at restore, which is why PublishReadyToRun is set there too. An architecture other
# than these two fails the build, rather than publish code that would not run.
RUN case "${TARGETARCH:-amd64}" in \
      amd64) echo linux-x64 ;; \
      arm64) echo linux-arm64 ;; \
      *) echo "Unsupported TARGETARCH '${TARGETARCH}': the image is built for amd64 and arm64" >&2; exit 1 ;; \
    esac > /runtime-identifier

# Only the API and the timeline library are built. The solution also references the test projects, which are not
# copied here, so it is never restored or built in the image.
COPY ./src/Sporer.Api/Sporer.Api.csproj ./Sporer.Api/
COPY ./src/Sporer.Timeline/Sporer.Timeline.csproj ./Sporer.Timeline/
RUN dotnet restore ./Sporer.Api/Sporer.Api.csproj -r "$(cat /runtime-identifier)" -p:PublishReadyToRun=true

COPY ./src/Sporer.Api ./Sporer.Api
COPY ./src/Sporer.Timeline ./Sporer.Timeline
RUN dotnet publish ./Sporer.Api/Sporer.Api.csproj -c Release -r "$(cat /runtime-identifier)" --self-contained false -p:PublishReadyToRun=true -o /app --no-restore

# The Ubuntu-based runtime image already ships /usr/share/zoneinfo, which converting UTC to a segment's local time
# (TimeZoneInfo.FindSystemTimeZoneById with IANA ids such as Europe/Oslo) needs. Do not switch to an image without it.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ENV ASPNETCORE_URLS=http://+:80
ENV ASPNETCORE_ENVIRONMENT=Production
WORKDIR /app

COPY --from=build-backend /app ./
# The API serves the web app from its web root, /app/wwwroot (see Program.cs).
COPY --from=build-web /web-dist ./wwwroot
ENTRYPOINT ["dotnet", "Sporer.Api.dll"]

LABEL org.opencontainers.image.source=https://github.com/ldellisola/sporer
LABEL org.opencontainers.image.description="Sporer is a (very) simple alternative to google Timelines"
LABEL org.opencontainers.image.licenses=MIT
