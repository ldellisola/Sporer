FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-backend
WORKDIR /src

# Only the API and the timeline library are built. The solution also references the test projects, which are not
# copied here, so it is never restored or built in the image.
COPY ./src/Sporer.Api/Sporer.Api.csproj ./Sporer.Api/
COPY ./src/Sporer.Timeline/Sporer.Timeline.csproj ./Sporer.Timeline/
RUN dotnet restore ./Sporer.Api/Sporer.Api.csproj

COPY ./src/Sporer.Api ./Sporer.Api
COPY ./src/Sporer.Timeline ./Sporer.Timeline
RUN dotnet publish ./Sporer.Api/Sporer.Api.csproj -c Release -o /app --no-restore

# The Ubuntu-based runtime image already ships /usr/share/zoneinfo, which converting UTC to a segment's local time
# (TimeZoneInfo.FindSystemTimeZoneById with IANA ids such as Europe/Oslo) needs. Do not switch to an image without it.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
ENV ASPNETCORE_URLS=http://+:80
ENV ASPNETCORE_ENVIRONMENT=Production
WORKDIR /app

COPY --from=build-backend /app ./
ENTRYPOINT ["dotnet", "Sporer.Api.dll"]

LABEL org.opencontainers.image.source=https://github.com/ldellisola/sporer
LABEL org.opencontainers.image.description="Sporer is a (very) simple alternative to google Timelines"
LABEL org.opencontainers.image.licenses=MIT
